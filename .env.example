# Copia in .env per lo sviluppo locale (fuori da Docker).
# In Docker questi valori stanno nella sezione "environment" del compose.

DOWNLOAD_DIR=./downloads
DATA_DIR=./data

TZ=Europe/Rome
MAX_WORKERS=2

# 0 = massima risoluzione disponibile
MAX_HEIGHT=0
PREFER_MP4=true

AUDIO_FORMAT=mp3
AUDIO_QUALITY=192

WRITE_METADATA_FILE=true
WRITE_THUMBNAIL=true
EMBED_SUBTITLES=false
SUBTITLE_LANGS=it,en

WINDOWS_SAFE_NAMES=true
TRIM_FILE_NAME=120
INCLUDE_VIDEO_ID=false
SKIP_EXISTING=true

# Limite banda, es. 5M. Vuoto = illimitato
RATE_LIMIT=

# Cookie in formato Netscape per contenuti privati / rate-limit
COOKIES_FILE=
